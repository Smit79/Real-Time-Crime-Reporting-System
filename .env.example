# ─── Server Configuration ──────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname

# ─── Authentication ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
REFRESH_SECRET=your_jwt_refresh_secret_here
REFRESH_EXPIRES_IN=30d

# ─── Cloudinary (Image Uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email Setup (Nodemailer) ──────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=Real-Time Crime Reporting <no-reply@example.com>

# ─── Push Notifications Setup (Optional) ───────────────────────
FCM_SERVER_KEY=your_fcm_server_key

# ─── Client URLs (Important for CORS & Emails) ─────────────────
# Separate multiple origins with commas. Since frontend is 
# served directly from backend in production, same-origin applies, 
# but defining this is helpful for external clients or specific setups.
CLIENT_URLS=https://your-app-domain.com

# ─── Note for Frontend ─────────────────────────────────────────
# When building the frontend in production, environment variables 
# VITE_API_URL and VITE_SOCKET_URL need to be provided to the build process.
# For same-origin (served by backend), relative URLs can be used:
# VITE_API_URL=/api/v1
# VITE_SOCKET_URL=/
